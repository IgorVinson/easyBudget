generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb+srv://IgorVinson:Karusel123@cluster0.uo334d5.mongodb.net/easyBudget?retryWrites=true&w=majority"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  hash      String
  createdAt DateTime @default(now()) @map("created_at")
  avatar    String?
  email     String   @unique
  language  String

  // Relation fields
  budgets Budget[]

  @@map("users")
}

model Budget {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  plannedMonth String
  createdAt    DateTime  @default(now()) @map("created_at")
  changedAt    DateTime? @map("changed_at")

  // Relation fields
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  categories Category[]

  @@map("budgets")
}

model Category {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  plannedAmount Int    @map("planned_amount")
  actualAmount  Int?   @map("actual_amount")
  // Relation fields
  budgetId      String
  budget        Budget @relation(fields: [budgetId], references: [id])

  @@map("categories")
}
